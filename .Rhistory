troca<-function(vet,a,b){
if(length(vet)==1){
if(vet[1]==a){
b
} else {
vet[1]
}
} else if(vet[1]==a){
c(b, troca(vet[-1],a,b))
} else if(vet[1]!=a){
c(vet[1], troca(vet[-1],a,b))
}
}
vet<-c(1,2,3,3,3,4,5)
troca(vet,3,5)
troca(vet,1,5)
troca<-function(vet,a,b){
for(i in 1:length(vet)){
if(vet[i]==a){
vet[i]<-a
}
}
return(vet)
}
troca(vet,3,6)
troca<-function(vet,a,b){
for(i in 1:length(vet)){
if(vet[i]==a){
vet[i]<-b
}
}
return(vet)
}
troca(vet,3,6)
