SIM_PA <- dados_sim_2 %>%
group_by(CODMUNRES) %>%
summarise(
ANO = 2016,
NIVEL = "MUNICIPIO",
TO = n(),
TORC = sum(complete.cases(pick(everything()))),
TORCR = sum(complete.cases(pick(everything()))),
TO_NN = sum(grepl("^[VWXY]", CAUSABAS), na.rm = TRUE),
TO_N = sum(!grepl("^[VWXY]", CAUSABAS), na.rm = TRUE),
TO_CB_I = sum(grepl("^[AB]", CAUSABAS), na.rm = TRUE),
TO_CB_N = sum(grepl("^[CD]", CAUSABAS), na.rm = TRUE),
TO_CB_C = sum(grepl("^I", CAUSABAS), na.rm = TRUE),
TO_CB_R = sum(grepl("^J", CAUSABAS), na.rm = TRUE),
TO_CB_O = sum(!grepl("^[VWXYABCDIJ]", CAUSABAS), na.rm = TRUE),
TO_M = sum(SEXO == "1", na.rm = TRUE),
TO_F = sum(SEXO == "2", na.rm = TRUE),
TO_F_IF = sum(SEXO == "2" & grepl("^4", IDADE) & as.numeric(substr(IDADE, 2, 3)) >= 15 & as.numeric(substr(IDADE, 2, 3)) <= 49, na.rm = TRUE),
TO_FT = sum(TIPOBITO == "1", na.rm = TRUE),
TO_NT = sum(grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27), na.rm = TRUE),
TO_NT_P = sum(grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 6), na.rm = TRUE),
TO_NT_T = sum(grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) >= 7 & as.numeric(substr(IDADE, 2, 3)) <= 27, na.rm = TRUE),
TO_PNT = sum((grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) >= 28) | (grepl("^3", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 11), na.rm = TRUE),
TONT_B = sum((grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27)) & RACACOR == "1", na.rm = TRUE),
TONT_PT = sum((grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27)) & RACACOR == "2", na.rm = TRUE),
TONT_A = sum((grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27)) & RACACOR == "3", na.rm = TRUE),
TONT_PD = sum((grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27)) & RACACOR == "4", na.rm = TRUE),
TONT_I = sum((grepl("^[01]", IDADE) | (grepl("^2", IDADE) & as.numeric(substr(IDADE, 2, 3)) <= 27)) & RACACOR == "5", na.rm = TRUE),
TO_MT = sum(OBITOMAT %in% c("1", "2", "3", "4", "5"), na.rm = TRUE),
TO_MT_DG = sum(OBITOMAT == "1", na.rm = TRUE),
TO_MT_PT = sum(OBITOMAT == "2", na.rm = TRUE),
TO_MT_AB = sum(OBITOMAT == "3", na.rm = TRUE),
TO_MT_42 = sum(OBITOMAT == "4", na.rm = TRUE),
TO_MT_43 = sum(OBITOMAT == "5", na.rm = TRUE),
TO_MT_P = sum(OBITOMAT %in% c("1", "2", "3", "4"), na.rm = TRUE),
TO_MT_P_I = sum(OBITOMAT %in% c("1", "2", "3", "4") & grepl("^4", IDADE) & as.numeric(substr(IDADE, 2, 3)) >= 15 & as.numeric(substr(IDADE, 2, 3)) <= 49, na.rm = TRUE),
TO_MT_P_ES = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "0", na.rm = TRUE),
TO_MT_P_EFI = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "1", na.rm = TRUE),
TO_MT_P_EFII = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "2", na.rm = TRUE),
TO_MT_P_EM = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "3", na.rm = TRUE),
TO_MT_P_ESI = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "4", na.rm = TRUE),
TO_MT_P_ESC = sum(OBITOMAT %in% c("1", "2", "3", "4") & ESC2010 == "5", na.rm = TRUE)
) %>%
ungroup() %>%
arrange(CODMUNRES)
